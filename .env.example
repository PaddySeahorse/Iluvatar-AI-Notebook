# Iluvatar AI Notebook — 环境变量模板
# 复制为 .env 并按需填写；.env 已被 git 忽略，不会入仓库。

# LLM API（OpenAI 兼容端点）
OPENI_API_URL=https://token.openi.org.cn/v1/chat/completions
OPENI_API_TOKEN=your_api_token_here
OPENI_API_MODEL=dsv4

# 可选：LiteLLM 传输层开关（1 启用 / 0 禁用 / 不设置则自动检测）
# USE_LITELLM=1

# 可选：GPU 内核供给器（需要天数智芯 IXUCA SDK 环境）
# USE_ILUVATAR_PROVISIONER=false

# 可选：服务端口
# OPENI_SELF_PORT=5000