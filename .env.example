# Iluvatar AI Notebook — 环境变量模板
# 通过环境变量预设配置；首次启动时这些值会作为种子写入
# ~/.Iluvatar-AI-Notebook/config.yaml，之后 UI 保存的配置也持久化到该文件。

# LLM API（上游模型提供方的 OpenAI 兼容端点 —— 供本地 LiteLLM Proxy 路由，
# OpenAI SDK 固定请求自启动的代理 http://localhost:4000/v1，不直连该地址）
OPENI_API_URL=https://token.openi.org.cn/v1/chat/completions
OPENI_API_TOKEN=your_api_token_here
OPENI_API_MODEL=dsv4

# 可选：LiteLLM Proxy 监听与请求地址（默认 http://localhost:4000，OpenAI SDK 写死此地址）
# LITELLM_PROXY_URL=http://localhost:4000
# LITELLM_PORT=4000

# 可选：LiteLLM 传输层开关（1 启用 / 0 禁用 / 不设置则自动检测）
# USE_OPENAI_SDK=1

# 可选：GPU 内核供给器（需要天数智芯 IXUCA SDK 环境）
# USE_ILUVATAR_PROVISIONER=false

# 可选：服务端口
# OPENI_SELF_PORT=5000